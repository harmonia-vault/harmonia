{
  "name": "harmonia-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harmonia（和弦）服务端：Cloudflare Workers + Durable Object",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787 --var DEV_MAIL_LOG:true --var ALLOW_REGISTRATION:true",
